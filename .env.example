NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-publishable-key-saja
# URL publik situs (untuk preview link WhatsApp/Facebook). Di Vercel boleh dikosongkan jika memakai domain Vercel.
NEXT_PUBLIC_SITE_URL=https://domain-anda.com

# --- Fitur Isi Otomatis AI (server-side, JANGAN pakai awalan NEXT_PUBLIC_) ---
ANTHROPIC_API_KEY=sk-ant-isi-key-anda
# Email admin Supabase (sama dengan di supabase.sql). Wajib: hanya akun ini yang boleh memakai AI.
ADMIN_EMAIL=admin@email.com
# Opsional: ganti model
# ANTHROPIC_MODEL=claude-sonnet-5-5
